using System;

public interface IPaymentProcessor
{
    void ProcessPayment(string user, double amount);
}

public class InternalPaymentProcessor : IPaymentProcessor
{
    public void ProcessPayment(string user, double amount)
    {
        Console.WriteLine($"[Stary System] Przetworzono płatność: Użytkownik: {user}, Kwota: {amount} PLN");
    }
} // <--- TUTAJ BRAKOWAŁO TEJ KLAMRY ZAMYKAJĄCEJ

public class ExternalStripeService
{
    public void MakeTransaction(float totalCurrency, string accountId, bool forceSca)
    {
        Console.WriteLine($"[Stripe API] Transakcja zakończona. AccountId: {accountId}, Kwota: {totalCurrency}, SCA: {forceSca}");
    }
}

public class StripeAdapter : IPaymentProcessor
{
    private readonly ExternalStripeService _stripeService;

    public StripeAdapter(ExternalStripeService stripeService)
    {
        _stripeService = stripeService;
    }

    public void ProcessPayment(string user, double amount)
    {
        // Tłumaczenie parametrów
        float totalCurrency = (float)amount;
        string accountId = user;
        bool forceSca = true;
        
        _stripeService.MakeTransaction(totalCurrency, accountId, forceSca);
    }
}

class Program
{
    static void Main()
    {
        Console.WriteLine("=== SYSTEM PŁATNOŚCI ===");

        // Płatność przez stary system
        IPaymentProcessor internalProcessor = new InternalPaymentProcessor();
        internalProcessor.ProcessPayment("MarekWozniak", 150.50);

        ExternalStripeService stripeService = new ExternalStripeService();
        IPaymentProcessor adapterProcessor = new StripeAdapter(stripeService);
        
        adapterProcessor.ProcessPayment("PiotrKaminski", 399.99);
    }
}
}
