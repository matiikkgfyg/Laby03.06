using System;

public enum Severity
{
    Low,
    Medium,
    High
}

public class Ticket
{
    public int Id { get; set; }
    public string Description { get; set; }
    public Severity Severity { get; set; }
    public decimal Cost { get; set; }
}

public abstract class SupportHandler
{
    private SupportHandler _nextHandler;

    public SupportHandler SetNext(SupportHandler handler)
    {
        _nextHandler = handler;
        return handler;
    }

    public virtual void HandleTicket(Ticket ticket)
    {
        if (_nextHandler != null)
        {
            _nextHandler.HandleTicket(ticket);
        }
    }
}

public class Level1Support : SupportHandler
{
    public override void HandleTicket(Ticket ticket)
    {
        if (ticket.Severity == Severity.Low)
        {
            Console.WriteLine($"[Level 1 - Konsultant] Rozwiązano problem: {ticket.Description} (Zgloszenie #{ticket.Id})");
        }
        else
        {
            Console.WriteLine($"[Level 1 - Konsultant] Brak uprawnień do zgloszenia #{ticket.Id}. Przekazuję dalej...");
            base.HandleTicket(ticket);
        }
    }
}

public class Level2Support : SupportHandler
{
    public override void HandleTicket(Ticket ticket)
    {
        if (ticket.Severity == Severity.Medium || ticket.Cost < 1000m)
        {
            Console.WriteLine($"[Level 2 - Inżynier] Rozwiazano problem: {ticket.Description} (Zgłoszenie #{ticket.Id}, Koszt: {ticket.Cost} PLN)");
        }
        else
        {
            Console.WriteLine($"[Level 2 - Inżynier] Problem zbyt trudny lub za drogi (Zgłoszenie #{ticket.Id}). Przekazuję do Dyrektora...");
            base.HandleTicket(ticket);
        }
    }
}

public class DirectorSupport : SupportHandler
{
    public override void HandleTicket(Ticket ticket)
    {
        Console.WriteLine($"[Level 3 - Dyrektor IT] Ostatecznie zamknieto zgloszenie: {ticket.Description} (Zgloszenie #{ticket.Id}, Koszt: {ticket.Cost} PLN)");
    }
}

class Program
{
    static void Main()
    {
        Console.WriteLine("=== SYSTEM HELPDESK ===");

        SupportHandler consultant = new Level1Support();
        SupportHandler engineer = new Level2Support();
        SupportHandler director = new DirectorSupport();

        consultant.SetNext(engineer).SetNext(director);
        var tickets = new[]
        {
            new Ticket { Id = 1, Description = "Reset hasla do poczty", Severity = Severity.Low, Cost = 0m },
            new Ticket { Id = 2, Description = "Instalacja oprogramowania biurowego", Severity = Severity.Medium, Cost = 150m },
            new Ticket { Id = 3, Description = "Awaria serwera bazy danych", Severity = Severity.High, Cost = 500m },
            new Ticket { Id = 4, Description = "Zakup nowych stacji roboczych (min. 4)", Severity = Severity.High, Cost = 15000m }
        };
        foreach (var ticket in tickets)
        {
            Console.WriteLine($"\n--- Zgloszenie #{ticket.Id} ---");
            consultant.HandleTicket(ticket);
        }
    }
}
